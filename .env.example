# Copie para .env para rodar localmente (npm run dev). O .env NÃO vai para o git.
# Este projeto não usa segredos reais; se algum dia usar, só entram aqui com valor de exemplo.

# Porta HTTP da API
PORT=3000

# Nível de log do pino: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
